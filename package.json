{
  "name": "mastermind-simulations",
  "version": "1.6.0",
  "private": true,
  "description": "Offline-ready interactive educational simulations for physics, mathematics, computing, and biology.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
